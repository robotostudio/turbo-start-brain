NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2025-08-29
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Vercel AI Gateway key for the /api/chat docs assistant
# (Vercel dashboard -> AI Gateway -> API keys). Optional: without it the
# chat route returns 503.
AI_GATEWAY_API_KEY=

# AI Gateway model id for the /api/chat docs assistant. Optional: defaults to
# anthropic/claude-haiku-4.5. Set to anthropic/claude-sonnet-5 to A/B a
# stronger model without a code change.
CHAT_MODEL=

# Sanity Context MCP endpoint serving the docs Knowledge Base the /api/chat
# assistant answers from (https://api.sanity.io/v1/context/organizations/<orgId>/mcp/<name>),
# plus an organisation token (not a project token) with Context Viewer
# permission. Both required: without either the chat route returns 503.
# Setup steps: README.md → "Ask AI (optional)".
SANITY_CONTEXT_MCP_URL=
SANITY_ORGANIZATION_TOKEN=
