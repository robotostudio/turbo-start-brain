{"_id": "seed-doc-ask-ai", "_type": "doc", "title": "Ask AI", "description": "An optional assistant that answers questions from your docs and links to its sources.", "slug": {"_type": "slug", "current": "/ask-ai"}, "order": 2, "body": [{"_type": "block", "_key": "k0201", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "k0200", "text": "Ask AI answers only from a Sanity Context Knowledge Base built from your docs, through the Vercel AI Gateway. It stays hidden until it is configured.", "marks": []}]}, {"_type": "callout", "_key": "k0202", "variant": "info", "body": [{"_type": "block", "_key": "k0204", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "k0203", "text": "Without the three environment variables below, the button does not appear and the chat API returns 503.", "marks": []}]}]}]}
