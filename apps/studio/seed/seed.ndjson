{"_id": "seed-doc-getting-started-installation", "_type": "doc", "title": "Installation", "description": "Clone the template, install dependencies and run the docs site and Studio locally.", "slug": {"_type": "slug", "current": "/getting-started/installation"}, "order": 1, "body": [{"_type": "block", "_key": "k0032", "style": "normal", "markDefs": [], "children": [{"_type": "span", "_key": "k0029", "text": "You need Node.js ", "marks": []}, {"_type": "span", "_key": "k0030", "text": "22.12", "marks": ["code"]}, {"_type": "span", "_key": "k0031", "text": " or later and pnpm, which the repository pins through Corepack.", "marks": []}]}, {"_type": "steps", "_key": "k0044", "items": [{"_type": "step", "_key": "k0045", "title": "Clone the repository", "content": [{"_type": "code", "_key": "k0033", "language": "bash", "code": "git clone https://github.com/robotostudio/turbo-start-brain.git\ncd turbo-start-brain", "filename": "terminal"}]}, {"_type": "step", "_key": "k0046", "title": "Install dependencies", "content": [{"_type": "code", "_key": "k0034", "language": "bash", "code": "corepack enable\npnpm install", "filename": "terminal"}]}, {"_type": "step", "_key": "k0047", "title": "Add your environment variables", "content": [{"_type": "block", "_key": "k0039", "style": "normal", "markDefs": [{"_key": "k0036", "_type": "customLink", "customLink": {"_type": "customUrl", "type": "internal", "openInNewTab": false, "internal": {"_type": "reference", "_ref": "seed-doc-getting-started-environment-variables"}}}], "children": [{"_type": "span", "_key": "k0035", "text": "Copy the example files and fill in your Sanity project. See ", "marks": []}, {"_type": "span", "_key": "k0037", "text": "Environment variables", "marks": ["k0036"]}, {"_type": "span", "_key": "k0038", "text": ".", "marks": []}]}]}, {"_type": "step", "_key": "k0048", "title": "Start both apps", "content": [{"_type": "code", "_key": "k0040", "language": "bash", "code": "pnpm dev", "filename": "terminal"}, {"_type":