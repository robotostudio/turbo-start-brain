{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "MIT",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "deploy-graphql": "sanity graphql deploy",
    "extract": "sanity schema extract",
    "check-types": "tsc --noEmit",
    "type": "sanity typegen generate",
    "sync-thumbnails": "node --experimental-strip-types ../../packages/sanity-blocks/scripts/sync-thumbnails.ts --target-root ../../apps/studio/static/thumbnails --file-prefix preview-",
    "postinstall": "pnpm sync-thumbnails"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/assist": "^6.2.2",
    "@sanity/client": "catalog:",
    "@sanity/context": "1.0.0",
    "@sanity/functions": "^1.8.0",
    "@sanity/icons": "catalog:",
    "@sanity/ui": "^3.5.5",
    "@sanity/vision": "^6.16.0",
    "@workspace/logger": "workspace:*",
    "@workspace/sanity-blocks": "workspace:*",
    "dotenv": "catalog:",
    "friendlier-words": "^1.2.0",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-is": "catalog:",
    "sanity": "catalog:",
    "sanity-plugin-asset-source-unsplash": "^7.0.26",
    "sanity-plugin-lucide-icon-picker": "^1.0.3",
    "sanity-plugin-media": "^4.3.6",
    "sanity-plugin-mux-input": "^5.0.13",
    "slugify": "catalog:",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@sanity/blueprints": "^0.20.2",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.1"
  }
}
