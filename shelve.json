{
  "$schema": "https://shelve.cloud/schema.json",
  "slug": "robotostudio",
  "defaultEnv": "development",
  "autoCreateProject": false,
  "sync": {
    "protectedEnvironments": ["production"],
    "environments": {
      "development": { "sourceOfTruth": "local" },
      "production": {
        "sourceOfTruth": "remote",
        "allowPush": false,
        "pullMode": "merge"
      }
    }
  }
}
