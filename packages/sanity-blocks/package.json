{
  "name": "@workspace/sanity-blocks",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "sync-thumbnails": "node --experimental-strip-types scripts/sync-thumbnails.ts",
    "test": "vitest run"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "catalog:"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@mux/mux-player-react": "^3.13.4",
    "@portabletext/markdown": "^1.5.0",
    "@portabletext/react": "^6.2.0",
    "@sanity/icons": "catalog:",
    "@workspace/logger": "workspace:*",
    "@workspace/tailwind-config": "workspace:*",
    "lucide-react": "catalog:",
    "sanity": "catalog:",
    "sanity-image": "^1.2.0",
    "schema-dts": "catalog:",
    "shiki": "^3.23.0",
    "slugify": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "next": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/sanity-blocks.ts",
    "./*/index": "./src/*/index.tsx",
