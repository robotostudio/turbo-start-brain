    "./internal/portable-text-to-markdown": "./src/internal/portable-text-to-markdown.ts",
    "./internal/safe-href": "./src/internal/safe-href.ts",
    "./internal/rich-text": "./src/internal/rich-text.tsx",
    "./internal/rich-text-tabs": "./src/internal/rich-text-tabs.tsx",
    "./internal/sanity-image": "./src/internal/sanity-image.tsx",
    "./internal/sanity-icon": "./src/internal/sanity-icon.tsx",
    "./internal/sanity-rich-text": "./src/internal/sanity-rich-text.ts",
    "./internal/schema-fields": "./src/internal/schema-fields.ts",
    "./internal/use-copy": "./src/internal/use-copy.ts",
    "./internal/use-disclosure-animation": "./src/internal/use-disclosure-animation.ts"
  }
